# Public repository (OD-0019): nothing below may ever be committed. tools/check_repo.py `public`
# enforces the same rules on anything force-added.

# Secrets and environment
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Local object store, data and databases (S1a uses a local-filesystem store; S1b data goes to a bucket, never git)
.hio-store/
data/
receipts/
releases/
artefacts/
catalogue/
*.duckdb
*.duckdb.wal
*.db
*.sqlite
*.sqlite3
*.parquet

# Python and tooling
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# OS and editors
.DS_Store
.idea/
.vscode/

# Infrastructure as code: state, plans and variables never enter git (infra/tofu/README.md)
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
.terraform/
crash.log
